@page
@model TornilloWeb.Pages.Admin.Sistema.GeneralEditModel
@{
    ViewData["Title"] = "Configuración General";
}

<div class="d-flex flex-wrap align-items-baseline gap-2 mb-4">
    <h1 class="h3 fw-bold mb-0"><i class="bi bi-gear text-primary me-2"></i>General</h1>
    <span class="text-muted small">Preferencias de visualización del sitio.</span>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-6">
        <div class="card border-0 shadow rounded-4 overflow-hidden">
            <div class="card-header bg-dark text-white py-3 px-4">
                <span class="fw-semibold"><i class="bi bi-zoom-in me-2"></i>Zoom del sitio</span>
            </div>
            <div class="card-body p-4">
                <p class="text-muted small mb-3">
                    Ajusta el tamaño de la interfaz para todo el sitio. El valor se guarda en este navegador.
                </p>

                <div class="d-flex align-items-center gap-3">
                    <button type="button" id="zoom-out" class="btn btn-outline-secondary rounded-circle" aria-label="Reducir zoom">
                        <i class="bi bi-dash-lg"></i>
                    </button>
                    <input type="range" id="zoom-range" class="form-range flex-grow-1" min="50" max="150" step="10" />
                    <button type="button" id="zoom-in" class="btn btn-outline-secondary rounded-circle" aria-label="Aumentar zoom">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                    <span id="zoom-value" class="badge bg-primary rounded-pill fs-6" style="min-width: 4rem;">100%</span>
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <button type="button" id="zoom-reset" class="btn btn-outline-primary rounded-pill d-inline-flex align-items-center gap-1">
                        <i class="bi bi-arrow-counterclockwise"></i>Restablecer
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const KEY = 'app-zoom';
            const DEF = 100, MIN = 50, MAX = 150, STEP = 10;

            const range = document.getElementById('zoom-range');
            const label = document.getElementById('zoom-value');

            const aplicar = z => {
                document.documentElement.style.zoom = z / 100;
                range.value = z;
                label.textContent = z + '%';
                localStorage.setItem(KEY, z);
            };

            const actual = () => parseInt(localStorage.getItem(KEY)) || DEF;

            range.value = actual();
            label.textContent = range.value + '%';

            range.addEventListener('input', () => aplicar(parseInt(range.value)));
            document.getElementById('zoom-in').addEventListener('click', () => aplicar(Math.min(actual() + STEP, MAX)));
            document.getElementById('zoom-out').addEventListener('click', () => aplicar(Math.max(actual() - STEP, MIN)));
            document.getElementById('zoom-reset').addEventListener('click', () => aplicar(DEF));
        })();
    </script>
}
