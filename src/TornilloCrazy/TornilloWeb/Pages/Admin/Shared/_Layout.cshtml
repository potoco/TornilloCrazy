<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tornillo Crazy</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TornilloWeb.styles.css" asp-append-version="true" />
</head>
<body class="bg-light">
    @{
        var menuId = "sidebarMenu";
    }
    <nav class="d-lg-none navbar navbar-dark bg-dark sticky-top">
        <div class="container-fluid">
            <button class="btn btn-outline-light btn-sm" type="button" data-bs-toggle="offcanvas" data-bs-target="#@menuId" aria-controls="@menuId" aria-label="Abrir menú">
                <i class="bi bi-list"></i>
            </button>
            <a class="navbar-brand ms-2" asp-area="" asp-page="/Admin/Index">
                <i class="bi bi-nut me-1"></i>Tornillo Crazy
            </a>
        </div>
    </nav>

    <aside id="@menuId" class="app-sidebar offcanvas-lg offcanvas-start bg-dark text-white d-flex flex-column" tabindex="-1" aria-labelledby="@(menuId)Label">
        <div class="d-flex align-items-center justify-content-between gap-2 p-3 border-bottom border-secondary">
            <a class="navbar-brand text-white fw-bold text-truncate mb-0" asp-area="" asp-page="/Admin/Index" id="@(menuId)Label">
                <i class="bi bi-nut me-2"></i><span class="sidebar-text">Tornillo Crazy</span>
            </a>
            <button type="button" class="btn btn-sm btn-outline-light d-none d-lg-inline-flex" onclick="document.body.classList.toggle('sidebar-collapsed')" aria-label="Colapsar menú">
                <i class="bi bi-list"></i>
            </button>
            <button type="button" class="btn-close btn-close-white d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#@menuId" aria-label="Cerrar menú"></button>
        </div>

        <ul class="nav nav-pills flex-column gap-1 p-3 flex-grow-1">
            <li class="nav-item">
                <a class="nav-link text-white-50 fw-semibold text-uppercase small" asp-area="" asp-page="/Admin/Index">
                    <i class="bi bi-speedometer2 me-2"></i><span class="sidebar-text">Inicio</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white d-flex justify-content-between align-items-center" data-bs-toggle="collapse" href="#menuProducto" role="button" aria-expanded="false" aria-controls="menuProducto">
                    <span><i class="bi bi-box-seam me-2"></i><span class="sidebar-text">Producto</span></span>
                    <i class="bi bi-chevron-down small sidebar-chevron"></i>
                </a>
                <div class="collapse sidebar-submenu" id="menuProducto">
                    <ul class="nav flex-column ms-4 border-start border-secondary ps-2 my-1">
                        <li><a class="nav-link text-white-50 py-1" asp-area="" asp-page="/Admin/Productos/ProductoEdit">Crear/Modificar/Eliminar</a></li>
                        <li><a class="nav-link text-white-50 py-1" asp-area="" asp-page="/Admin/Productos/IngresarStock">Ingresar Stock</a></li>
                        <li><a class="nav-link text-white-50 py-1" asp-area="" asp-page="/Admin/Productos/BajarStock">Bajar Stock</a></li>
                    </ul>
                </div>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white d-flex justify-content-between align-items-center" data-bs-toggle="collapse" href="#menuProveedor" role="button" aria-expanded="false" aria-controls="menuProveedor">
                    <span><i class="bi bi-truck me-2"></i><span class="sidebar-text">Proveedor</span></span>
                    <i class="bi bi-chevron-down small sidebar-chevron"></i>
                </a>
                <div class="collapse sidebar-submenu" id="menuProveedor">
                    <ul class="nav flex-column ms-4 border-start border-secondary ps-2 my-1">
                        <li><a class="nav-link text-white-50 py-1" asp-area="" asp-page="/Admin/Proveedores/ProveedorCrud">Crear o Editar</a></li>
                        <li><a class="nav-link text-white-50 py-1" href="#">Ver Lista de Precios</a></li>
                        <li><a class="nav-link text-white-50 py-1" asp-area="" asp-page="/Admin/Proveedores/CargarExcel">Cargar Excel</a></li>
                    </ul>
                </div>
            </li>
        </ul>

        <div class="sidebar-footer p-3 border-top border-secondary mt-auto">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-person-circle fs-4 text-white-50"></i>
                    <span class="sidebar-text small text-white-50 text-truncate">@User.Identity?.Name</span>
                </div>
                <form method="post" asp-page="/Logout">
                    <button type="submit" class="btn btn-sm btn-outline-light w-100 rounded-pill">
                        <i class="bi bi-box-arrow-right"></i><span class="sidebar-text ms-1">Cerrar sesión</span>
                    </button>
                </form>
            }
            else
            {
                <a class="btn btn-sm btn-primary w-100 rounded-pill" asp-page="/Login">
                    <i class="bi bi-box-arrow-in-right"></i><span class="sidebar-text ms-1">Iniciar sesión</span>
                </a>
            }
        </div>
    </aside>

    <div class="app-main d-flex flex-column">
        <main role="main">
            <div class="app-content-scroll p-3 p-lg-4">
                @RenderBody()
            </div>
        </main>

        <footer class="border-top footer text-muted py-2 px-3 bg-dark">
            <div class="container-fluid small text-white d-flex flex-row-reverse">
                Tornillo Crazy - @DateTime.Now.Year<i class="bi bi-nut me-1"></i>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
